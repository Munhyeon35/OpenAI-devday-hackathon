# 현재 데모는 환경변수 없이 실행됩니다.
# OpenStreetMap 타일은 hospital-map.tsx에 설정되어 있으며 API 키가 필요 없습니다.

# Supabase 도입 시 프로젝트 설정에서 복사하세요. 현재 SDK·DB·인증은 미연결입니다.
# NEXT_PUBLIC_에는 공개 값만 설정하고 secret/service role 키는 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Twilio + OpenAI Realtime voice bridge (server-side only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
PUBLIC_VOICE_URL=
VOICE_API_TOKEN=
VOICE_PORT=3001
VOICE_MAX_CONCURRENT=5

# BedLink hospital dispatch
# demo: no external calls. live: Twilio + GPT-Live.
APP_MODE=demo
PUBLIC_BASE_URL=https://your-tunnel.example
OPERATOR_TOKEN=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_BACKEND_MODEL=gpt-6-luna
OPENAI_VOICE=marin
# Optional outbound result receiver (gpt-backbed). Empty = local backend only.
GPT_BACKBED_URL=
GPT_BACKBED_TOKEN=
DATABASE_PATH=data/dispatch.sqlite3
MAX_CALL_SECONDS=180

# Next.js -> hospital dispatch backend (server-side only)
DISPATCH_BACKEND_URL=http://127.0.0.1:8000

# Optional map provider. Defaults to OpenStreetMap when unset.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
